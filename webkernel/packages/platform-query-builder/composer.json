{
    "name": "webkernel/platform-query-builder",
    "description": "Composable query constraints and filters for Webkernel Platform tables.",
    "version": "5.9.0",
    "license": "proprietary",
    "homepage": "https://www.webkernelphp.com",
    "require": {
        "php": ">=8.5.12",
        "webkernel/platform-actions": "self.version",
        "webkernel/platform-forms": "self.version",
        "webkernel/platform-schemas": "self.version",
        "webkernel/platform-support": "self.version",
        "webkernel/database": "^0.12.0",
        "webkernel/http-security-csrf": "^0.12.0",
        "webkernel/orm": "^0.12.0",
        "webkernel/utilities": "^0.12.0"
    },
    "autoload": {
        "psr-4": {
            "Webkernel\\Platform\\QueryBuilder\\": "src"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
