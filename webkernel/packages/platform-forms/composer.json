{
    "name": "webkernel/platform-forms",
    "description": "Schema-driven forms and input components for Webkernel Platform.",
    "version": "5.9.0",
    "license": "proprietary",
    "homepage": "https://www.webkernelphp.com",
    "require": {
        "php": ">=8.5.12",
        "webkernel/platform-actions": "self.version",
        "webkernel/platform-schemas": "self.version",
        "webkernel/platform-support": "self.version",
        "ueberdosis/tiptap-php": "^2.0",
        "webkernel/console": "^0.12.0",
        "webkernel/datetime": "^0.12.0",
        "webkernel/filesystem": "^0.12.0",
        "webkernel/http-foundation": "^0.12.0",
        "webkernel/http-security-csrf": "^0.12.0",
        "webkernel/orm": "^0.12.0",
        "webkernel/service-provider": "^0.12.0",
        "webkernel/utilities": "^0.12.0",
        "webkernel/validation": "^0.12.0",
        "webkernel/view": "^0.12.0"
    },
    "suggest": {
        "fakerphp/faker": "Required to generate fake rich content and Markdown."
    },
    "autoload": {
        "files": [
            "src/helpers.php"
        ],
        "psr-4": {
            "Webkernel\\Platform\\Forms\\": "src"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "webkernel": {
            "provider": "Webkernel\\Platform\\Forms\\Providers\\FormsWebkernelProvider"
        }
    }
}
