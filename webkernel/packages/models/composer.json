{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "webkernel/models",
    "description": "Explicit active-record models for Webkernel applications.",
    "type": "library",
    "license": "proprietary",
    "version": "0.12.0",
    "authors": [
        {
            "name": "El Moumen Yassine",
            "email": "yassine@numerimondes.com",
            "role": "Author"
        }
    ],
    "require": {
        "php": ">=8.5.12",
        "webkernel/database": "self.version",
        "webkernel/service-provider": "^0.12.0"
    },
    "autoload": {
        "psr-4": {
            "Webkernel\\Models\\": "src/"
        }
    },
    "extra": {
        "webkernel": {
            "package-declaration": "Webkernel\\Models\\Providers\\ModelsPDeclaration",
            "$schema": "https://webkernelphp.com/schemas/webkernel/lifecycle/extra-webkernel.v1.json",
            "lifecycle": []
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
