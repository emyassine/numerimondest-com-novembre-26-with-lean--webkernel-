{
    "name": "webkernel/platform-widgets",
    "description": "Dashboard widgets and chart components for Webkernel Platform.",
    "version": "5.9.0",
    "license": "proprietary",
    "homepage": "https://www.webkernelphp.com",
    "require": {
        "php": ">=8.5.12",
        "webkernel/platform-schemas": "self.version",
        "webkernel/platform-support": "self.version",
        "webkernel/console": "^0.12.0",
        "webkernel/http-security-csrf": "^0.12.0",
        "webkernel/orm": "^0.12.0",
        "webkernel/service-provider": "^0.12.0",
        "webkernel/utilities": "^0.12.0",
        "webkernel/view": "^0.12.0"
    },
    "autoload": {
        "psr-4": {
            "Webkernel\\Platform\\Widgets\\": "src"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "webkernel": {
            "provider": "Webkernel\\Platform\\Widgets\\Providers\\WidgetsWebkernelProvider"
        }
    }
}
