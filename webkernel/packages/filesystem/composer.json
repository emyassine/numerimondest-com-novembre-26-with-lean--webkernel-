{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "webkernel/filesystem",
    "description": "Filesystem APIs and the internal Webkernel storage engine.",
    "type": "library",
    "license": "MIT",
    "version": "0.12.0",
    "authors": [
        {
            "name": "Webkernel",
            "email": "platform@webkernelphp.com"
        }
    ],
    "require": {
        "php": ">=8.5.12",
        "ext-fileinfo": "*",
        "psr/http-message": "^2.0",
        "psr/log": "^3.0",
        "symfony/filesystem": "^7.4.0 || ^8.0.0",
        "symfony/finder": "^7.4.0 || ^8.0.0",
        "symfony/http-foundation": "^7.4.0 || ^8.0.0",
        "symfony/mime": "^7.4.0 || ^8.0.0",
        "symfony/string": "^7.4.0 || ^8.0.0",
        "webkernel/config": "^0.12.0",
        "webkernel/container": "^0.12.0",
        "webkernel/utilities": "^0.12.0"
    },
    "autoload": {
        "psr-4": {
            "Webkernel\\Filesystem\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
