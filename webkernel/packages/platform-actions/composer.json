{
    "name": "webkernel/platform-actions",
    "description": "Composable actions and modal interfaces for Webkernel Platform components.",
    "version": "5.9.0",
    "license": "proprietary",
    "homepage": "https://www.webkernelphp.com",
    "require": {
        "php": ">=8.5.12",
        "webkernel/platform-forms": "self.version",
        "webkernel/platform-infolists": "self.version",
        "webkernel/platform-notifications": "self.version",
        "webkernel/platform-support": "self.version",
        "webkernel/accounts": "^0.12.0",
        "webkernel/console": "^0.12.0",
        "webkernel/container": "^0.12.0",
        "webkernel/database": "^0.12.0",
        "webkernel/datetime": "^0.12.0",
        "webkernel/events": "^0.12.0",
        "webkernel/exporters-csv": "^0.12.0",
        "webkernel/exporters-xlsx": "^0.12.0",
        "webkernel/filesystem": "^0.12.0",
        "webkernel/filesystem-aws": "^0.12.0",
        "webkernel/http-foundation": "^0.12.0",
        "webkernel/http-security-csrf": "^0.12.0",
        "webkernel/orm": "^0.12.0",
        "webkernel/queue": "^0.12.0",
        "webkernel/route": "^0.12.0",
        "webkernel/service-provider": "^0.12.0",
        "webkernel/utilities": "^0.12.0",
        "webkernel/validation": "^0.12.0",
        "webkernel/view": "^0.12.0"
    },
    "autoload": {
        "psr-4": {
            "Webkernel\\Platform\\Actions\\": "src"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "suggest": {
        "webkernel/filesystem-aws": "Required for AWS S3 imports once the S3 storage driver is registered."
    },
    "extra": {
        "webkernel": {
            "provider": "Webkernel\\Platform\\Actions\\Providers\\ActionsWebkernelProvider"
        }
    }
}
