{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "webkernel/http-foundation",
    "description": "Symfony HttpFoundation dependency for Webkernel.",
    "type": "library",
    "license": "proprietary",
    "version": "0.12.0",
    "authors": [
        {
            "name": "El Moumen Yassine",
            "email": "yassine@numerimondes.com",
            "role": "Author"
        }
    ],
    "require": {
        "php": ">=8.5.12",
        "symfony/http-foundation": "^8.1",
        "webkernel/accounts": "^0.12.0",
        "webkernel/container": "^0.12.0",
        "webkernel/database": "^0.12.0",
        "webkernel/filesystem": "^0.12.0",
        "webkernel/orm": "^0.12.0",
        "webkernel/route": "^0.12.0",
        "webkernel/service-provider": "^0.12.0",
        "webkernel/session": "^0.12.0",
        "webkernel/utilities": "^0.12.0",
        "webkernel/validation": "^0.12.0"
    },
    "autoload": {
        "psr-4": {
            "Webkernel\\HttpFoundation\\": "src/"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "extra": {
        "webkernel": {
            "package-declaration": "Webkernel\\HttpFoundation\\Providers\\HttpFoundationPDeclaration",
            "$schema": "https://webkernelphp.com/schemas/webkernel/lifecycle/extra-webkernel.v1.json",
            "lifecycle": []
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
