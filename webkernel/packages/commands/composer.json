{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "webkernel/commands",
    "description": "Built-in Webkernel console commands.",
    "type": "library",
    "license": "proprietary",
    "version": "0.12.0",
    "require": {
        "php": ">=8.5.12",
        "webkernel/config": "^0.12.0",
        "webkernel/console": "self.version",
        "webkernel/http-security-csrf": "^0.12.0",
        "webkernel/route": "self.version",
        "webkernel/service-provider": "self.version"
    },
    "autoload": {
        "psr-4": {
            "Webkernel\\Commands\\": "src/"
        }
    },
    "extra": {
        "webkernel": {
            "package-declaration": "Webkernel\\Commands\\Providers\\CommandsPDeclaration",
            "$schema": "https://webkernelphp.com/schemas/webkernel/lifecycle/extra-webkernel.v1.json",
            "provider": "Webkernel\\Commands\\Providers\\CommandsProvider",
            "lifecycle": []
        }
    }
}
