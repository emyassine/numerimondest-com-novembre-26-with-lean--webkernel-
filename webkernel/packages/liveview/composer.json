{
    "name": "webkernel/liveview",
    "description": "Reactive, server-rendered components for Webkernel applications.",
    "version": "4.4.7",
    "license": "proprietary",
    "require": {
        "php": ">=8.5.12",
        "league/mime-type-detection": "^1.9",
        "symfony/console": "^6.0|^7.0|^8.0",
        "symfony/http-kernel": "^6.2|^7.0|^8.0",
        "webkernel/accounts": "^0.12.0",
        "webkernel/broadcasting": "^0.12.0",
        "webkernel/cache": "^0.12.0",
        "webkernel/config": "^0.12.0",
        "webkernel/console": "^0.12.0",
        "webkernel/container": "^0.12.0",
        "webkernel/database": "^0.12.0",
        "webkernel/datetime": "^0.12.0",
        "webkernel/filesystem": "^0.12.0",
        "webkernel/http-foundation": "^0.12.0",
        "webkernel/http-security-csrf": "^0.12.0",
        "webkernel/mail": "^0.12.0",
        "webkernel/models": "^0.12.0",
        "webkernel/notifications": "^0.12.0",
        "webkernel/orm": "^0.12.0",
        "webkernel/queue": "^0.12.0",
        "webkernel/route": "^0.12.0",
        "webkernel/service-provider": "^0.12.0",
        "webkernel/session": "^0.12.0",
        "webkernel/testing": "^0.12.0",
        "webkernel/utilities": "^0.12.0",
        "webkernel/validation": "^0.12.0",
        "webkernel/view": "^0.12.0"
    },
    "autoload": {
        "files": [
            "src/helpers.php"
        ],
        "psr-4": {
            "Webkernel\\Liveview\\": "src/"
        }
    },
    "extra": {
        "webkernel": {
            "package-declaration": "Webkernel\\Liveview\\Providers\\LiveviewPackageDeclaration",
            "$schema": "https://webkernelphp.com/schemas/webkernel/lifecycle/extra-webkernel.v1.json",
            "provider": "Webkernel\\Liveview\\Providers\\LiveviewWebkernelProvider"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
