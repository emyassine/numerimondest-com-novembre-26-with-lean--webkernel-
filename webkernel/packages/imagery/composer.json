{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "webkernel/imagery",
    "description": "Webkernel imagery: icons, brands, pixmaps.",
    "version": "0.12.0",
    "type": "webkernel-stdlib",
    "license": "EPL-2.0",
    "authors": [
        {
            "name": "El Moumen Yassine",
            "email": "yassine@numerimondes.com"
        }
    ],
    "require": {
        "php": ">=8.5.12",
        "webkernel/http-security-csrf": "^0.12.0",
        "webkernel/route": "^0.12.0",
        "webkernel/service-provider": "^0.12.0",
        "webkernel/view": "self.version"
    },
    "autoload": {
        "psr-4": {
            "Webkernel\\Imagery\\": "src/"
        },
        "files": [
            "functions/branding.php",
            "functions/icon.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Webkernel\\Imagery\\Tests\\": "tests/"
        }
    },
    "extra": {
        "webkernel": {
            "package-declaration": "Webkernel\\Imagery\\Providers\\ImageryPDeclaration",
            "provider": "Webkernel\\Imagery\\Providers\\ImageryProvider"
        }
    },
    "config": {
        "sort-packages": true
    }
}
