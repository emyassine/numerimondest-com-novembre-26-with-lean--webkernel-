{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "webkernel/route",
    "description": "Webkernel routing.",
    "version": "0.12.0",
    "homepage": "https://www.webkernelphp.com",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": ">=8.5.12",
        "psr/http-message": "^2.0",
        "webkernel/container": "self.version",
        "webkernel/http-foundation": "^0.12.0",
        "webkernel/service-provider": "^0.12.0",
        "webkernel/session": "^0.12.0",
        "webkernel/utilities": "self.version",
        "webkernel/view": "self.version"
    },
    "autoload": {
        "psr-4": {
            "Webkernel\\Route\\": "src/"
        },
        "files": [
            "load.route.function.php"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "extra": {
        "webkernel": {
            "package-declaration": "Webkernel\\Route\\Providers\\RoutePDeclaration"
        }
    }
}
