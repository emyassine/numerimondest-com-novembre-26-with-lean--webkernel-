{
    "name": "webkernel/platform-notifications",
    "description": "Native toast and database notification interfaces for Webkernel Platform.",
    "version": "5.9.0",
    "license": "proprietary",
    "homepage": "https://www.webkernelphp.com",
    "require": {
        "php": ">=8.5.12",
        "webkernel/platform-support": "self.version"
    },
    "autoload": {
        "psr-4": {
            "Webkernel\\Platform\\Notifications\\": "src"
        }
    },
    "autoload-dev": {
        "files": ["src/Testing/helpers.php"]
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
