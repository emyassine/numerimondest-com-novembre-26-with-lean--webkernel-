    "name": "webkernel/http-error-pages",
    "description": "Configurable, localized HTTP error pages for Webkernel applications.",
    "type": "library",
    "license": "proprietary",
    "version": "0.12.0",
    "require": {
        "php": ">=8.5.12",
        "webkernel/config": "self.version",
        "webkernel/http-security-csrf": "^0.12.0",
        "webkernel/i18n": "self.version",
        "webkernel/route": "self.version",
        "webkernel/service-provider": "self.version",
        "webkernel/view": "self.version"
    },
    "autoload": {
        "psr-4": {
            "Webkernel\\HttpErrorPages\\": "src/"
        }
    }
}
