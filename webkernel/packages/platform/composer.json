{
    "name": "webkernel/platform",
    "description": "Webkernel's admin platform for authenticated dashboards, data management, and modular UI.",
    "version": "5.9.0",
    "license": "proprietary",
    "homepage": "https://www.webkernelphp.com",
    "require": {
        "php": ">=8.5.12",
        "composer-runtime-api": "^2.1",
        "webkernel/platform-actions": "self.version",
        "webkernel/platform-forms": "self.version",
        "webkernel/platform-infolists": "self.version",
        "webkernel/platform-notifications": "self.version",
        "webkernel/platform-schemas": "self.version",
        "webkernel/platform-support": "self.version",
        "webkernel/platform-tables": "self.version",
        "webkernel/platform-widgets": "self.version",
        "pragmarx/google2fa": "^8.0|^9.0",
        "webkernel/accounts": "^0.12.0",
        "webkernel/cache": "^0.12.0",
        "webkernel/console": "^0.12.0",
        "webkernel/container": "^0.12.0",
        "webkernel/cookie": "^0.12.0",
        "webkernel/cryptography": "^0.12.0",
        "webkernel/database": "^0.12.0",
        "webkernel/datetime": "^0.12.0",
        "webkernel/events": "^0.12.0",
        "webkernel/filesystem": "^0.12.0",
        "webkernel/http-foundation": "^0.12.0",
        "webkernel/http-security-csrf": "^0.12.0",
        "webkernel/i18n": "^0.12.0",
        "webkernel/notifications": "^0.12.0",
        "webkernel/orm": "^0.12.0",
        "webkernel/qrcode": "^0.12.0",
        "webkernel/queue": "^0.12.0",
        "webkernel/route": "^0.12.0",
        "webkernel/serialization": "^0.12.0",
        "webkernel/service-provider": "^0.12.0",
        "webkernel/session": "^0.12.0",
        "webkernel/utilities": "^0.12.0",
        "webkernel/validation": "^0.12.0",
        "webkernel/view": "^0.12.0"
    },
    "autoload": {
        "files": [
            "src/global_helpers.php",
            "src/helpers.php"
        ],
        "psr-4": {
            "Webkernel\\Platform\\": "src"
        }
    },
    "extra": {
        "webkernel": {
            "package-declaration": "Webkernel\\Platform\\Providers\\PlatformPackageDeclaration",
            "$schema": "https://webkernelphp.com/schemas/webkernel/lifecycle/extra-webkernel.v1.json",
            "provider": "Webkernel\\Platform\\Providers\\PlatformWebkernelProvider"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
