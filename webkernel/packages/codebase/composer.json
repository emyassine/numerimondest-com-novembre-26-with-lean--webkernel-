{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "webkernel/codebase",
    "description": "Webkernel application bootstrap and runtime integration.",
    "type": "library",
    "license": "proprietary",
    "version": "0.12.0",
    "require": {
        "php": ">=8.5.12",
        "webkernel/platform-actions": "^5.9",
        "webkernel/platform": "^5.9",
        "webkernel/platform-forms": "^5.9",
        "webkernel/platform-notifications": "^5.9",
        "webkernel/platform-schemas": "^5.9",
        "webkernel/platform-support": "^5.9",
        "webkernel/platform-tables": "^5.9",
        "webkernel/platform-widgets": "^5.9",
        "webkernel/accounts": "self.version",
        "webkernel/change-watcher": "self.version",
        "webkernel/commands": "self.version",
        "webkernel/config": "self.version",
        "webkernel/console": "self.version",
        "webkernel/container": "self.version",
        "webkernel/database": "self.version",
        "webkernel/http-error-pages": "self.version",
        "webkernel/http-security-csrf": "self.version",
        "webkernel/http-runtime": "self.version",
        "webkernel/i18n": "self.version",
        "webkernel/imagery": "self.version",
        "webkernel/lifecycle": "self.version",
        "webkernel/models": "self.version",
        "webkernel/package-assets": "self.version",
        "webkernel/route": "self.version",
        "webkernel/service-provider": "self.version",
        "webkernel/session": "self.version",
        "webkernel/view": "self.version"
    },
    "autoload": {
        "psr-4": {
            "Webkernel\\Codebase\\": "src/",
            "Webkernel\\Getters\\": "src/Getters/"
        },
        "files": [
            "functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Webkernel\\Codebase\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "extra": {
        "webkernel": {
            "package-declaration": "Webkernel\\Codebase\\Providers\\CodebasePDeclaration",
            "$schema": "https://webkernelphp.com/schemas/webkernel/lifecycle/extra-webkernel.v1.json",
            "provider": "Webkernel\\Codebase\\Providers\\CodebaseProvider",
            "lifecycle": {
                "events": {
                    "post-autoload-dump": "Webkernel\\Codebase\\Compiler\\CompileDeclarations"
                }
            }
        }
    }
}
