{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "webkernel/orm",
    "description": "Eloquent object relational mapper and database subsystem for Webkernel.",
    "type": "library",
    "license": "MIT",
    "version": "0.12.0",
    "authors": [
        {
            "name": "Webkernel",
            "email": "platform@webkernelphp.com"
        }
    ],
    "require": {
        "php": ">=8.5.12",
        "webkernel/accounts": "^0.12.0",
        "webkernel/broadcasting": "^0.12.0",
        "webkernel/console": "^0.12.0",
        "webkernel/container": "^0.12.0",
        "webkernel/cryptography": "^0.12.0",
        "webkernel/database": "self.version",
        "webkernel/datetime": "^0.12.0",
        "webkernel/events": "^0.12.0",
        "webkernel/http-foundation": "^0.12.0",
        "webkernel/math": "^0.12.0",
        "webkernel/queue": "^0.12.0",
        "webkernel/route": "^0.12.0",
        "webkernel/utilities": "^0.12.0",
        "webkernel/view": "^0.12.0"
    },
    "autoload": {
        "psr-4": {
            "Webkernel\\ORM\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
